# ═══════════════════════════════════════════════════════════
# HireHub — AWS Environment Variables Reference
# Copy this file to .env and configure your values
# ═══════════════════════════════════════════════════════════

# ── Application ──
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net

# ── Database (AWS RDS or Local) ──
# Option A: Connection URL (AWS RDS PostgreSQL recommended)
# DATABASE_URL=postgresql://hirehub_admin:YourSecurePassword@your-rds-instance.cxxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/hirehub_production
# DATABASE_DIALECT=postgres
# DATABASE_SSL=true

# Option B: Individual parameters (MySQL / local dev)
DATABASE_NAME=job_portal
DATABASE_USER=root
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_DIALECT=mysql
# DATABASE_SSL=false

# DB Connection Pool
# DB_POOL_MAX=10
# DB_POOL_MIN=0

# ── Authentication (JWT) ──
SECRET_KEY=your-jwt-secret-key-at-least-32-chars
JWT_EXPIRY=7d

# ── AWS Credentials (IAM Least-Privilege User) ──
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# ── AWS S3 (Document Storage) ──
AWS_S3_BUCKET=hirehub-documents-production
# CLOUDFRONT_DOMAIN=https://d1234567890.cloudfront.net

# ── AWS SES (Email Notifications) ──
AWS_SES_FROM_EMAIL=notifications@yourdomain.com

# ── AWS Lambda (Serverless Tasks) ──
# AWS_LAMBDA_RESUME_PARSER_ARN=arn:aws:lambda:us-east-1:123456789012:function:hirehub-resume-parser

# ── Redis (BullMQ Queue & Cache) ──
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://default:password@your-elasticache.xxxxxx.0001.use1.cache.amazonaws.com:6379

# ── Cloudinary (Legacy Image Uploads — optional) ──
CLOUD_NAME=your_cloudinary_cloud
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# ── OpenAI (AI Copilot & Analysis) ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── ChromaDB (Vector Store — optional) ──
# CHROMA_HOST=http://localhost:8010
